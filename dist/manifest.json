{
  "manifest_version": 3,
  "name": "Faceit God's Eye",
  "version": "1.0.0",
  "description": "Простое расширение для поиска аккаунта Faceit по steam пользователя.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "images/icon-16x16.png",
    "48": "images/icon-48x48.png",
    "128": "images/icon-128x128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16x16.png",
      "48": "images/icon-48x48-off.png",
      "128": "images/icon-128x128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "web_accessible_resources": [{
    "resources": ["images/*"],
    "matches": ["<all_urls>"]
  }]
}